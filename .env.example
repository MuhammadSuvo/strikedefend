# Local SQLite (default for local development)
DATABASE_URL="file:./dev.db"

# Or PostgreSQL / Neon for production:
# DATABASE_URL="postgresql://user:password@host:5432/strikedefend?sslmode=require"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary (https://cloudinary.com/console)
# Required for image uploads on Cloudflare Workers (no local disk).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Contact form email alerts (https://resend.com)
# Without RESEND_API_KEY, leads still save in Admin → Leads (no email).
RESEND_API_KEY=""
# Where to receive alerts (defaults to site settings email)
LEAD_NOTIFY_TO="contact@strikedefend.com"
# From address — after verifying your domain in Resend, use e.g.:
# LEAD_NOTIFY_FROM="StrikeDefend <contact@strikedefend.com>"
LEAD_NOTIFY_FROM="StrikeDefend <onboarding@resend.dev>"

# Cloudflare (Workers / OpenNext)
# Content JSON is stored in Workers KV binding CONTENT_KV (see wrangler.jsonc).
# Set ENABLE_CF_DEV=1 to use KV bindings during `next dev`.
# ENABLE_CF_DEV=1
# FORCE_FS_STORE=1
# FORCE_CLOUDFLARE_RUNTIME=1

# Initial admin user created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@strikedefend.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Site Admin"
